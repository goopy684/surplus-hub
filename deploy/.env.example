# ===== Registry =====
ACR=surplushubacr.azurecr.io
IMAGE_TAG=latest

# ===== Database =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=surplushub

# ===== API (FastAPI) =====
APP_ENV=prod
PROJECT_NAME=Surplus Hub API
API_V1_STR=/api/v1
SECRET_KEY=change-me-production-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["https://your-domain.com"]
MAX_UPLOAD_SIZE_MB=10
AI_PROVIDER=default
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Clerk
# CLERK_PEM_PUBLIC_KEY=
CLERK_SECRET_KEY=

# S3 (선택)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=surplus-hub-uploads
AWS_S3_REGION=ap-northeast-2

# AI (선택)
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=

# ===== Web (Next.js runtime) =====
NEXT_PUBLIC_API_BASE_URL=https://your-domain.com/api/v1
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
