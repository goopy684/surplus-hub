{
  "expo": {
    "name": "자투리",
    "slug": "surplus-hub-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "surplushub",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.surplushub.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "등록할 자투리 자재의 사진을 직접 촬영하기 위해 카메라를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "사진첩에 저장된 자재 사진을 골라 등록 글에 첨부하기 위해 사진 접근 권한이 필요합니다.",
        "NSLocationWhenInUseUsageDescription": "자재를 등록할 때 현재 위치를 거래 지역으로 자동 입력하기 위해 사용합니다. 앱을 사용하는 동안에만 확인합니다."
      }
    },
    "android": {
      "package": "com.surplushub.mobile",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ed701d"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f9f7f6"
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ed701d",
          "defaultChannel": "default"
        }
      ],
      "@sentry/react-native"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4cac4697-4c75-4048-965d-67bf6b11625c"
      }
    },
    "owner": "seongchae"
  }
}
