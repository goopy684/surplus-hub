# ===== Environment =====
APP_ENV=local  # local | dev | stage | prod

# ===== Application =====
PROJECT_NAME=Surplus Hub API
API_V1_STR=/api/v1

# ===== Database =====
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=surplushub
# Optional: override with full URL
# DATABASE_URL=postgresql://user:password@host/dbname
# "db" only resolves inside docker-compose. Running uvicorn/alembic on the host
# (run.sh option 2 does this for you) needs the mapped port instead:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5433/surplushub alembic upgrade head

# ===== Authentication =====
# REQUIRED for non-local APP_ENV. Must be >= 32 random chars (placeholders are rejected at boot).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== CORS =====
# JSON list of allowed origins. "*" is permitted ONLY for local/test APP_ENV;
# non-local environments must use an explicit allow-list (enforced at boot).
# Example for prod: CORS_ORIGINS=["https://app.example.com","https://www.example.com"]
CORS_ORIGINS=["*"]

# ===== Social auth (Google) =====
# OAuth 2.0 Web client ID from Google Cloud Console. Enables POST /auth/google.
# Must match the web app's NEXT_PUBLIC_GOOGLE_CLIENT_ID. Unset => /auth/google 503.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ===== Frontend =====
# Public web app base URL — used to build password-reset links.
# FRONTEND_URL=http://localhost:4000

# ===== Email (SMTP) =====
# Password-reset mail is sent via SMTP when APP_ENV is non-local. Leave unset to
# disable delivery (the app only logs a warning). Use port 465 for implicit TLS,
# or 587 with SMTP_TLS=true for STARTTLS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-smtp-password
# SMTP_TLS=true
# EMAILS_FROM_EMAIL=no-reply@surplushub.kr
# EMAILS_FROM_NAME=Surplus Hub

# ===== AWS S3 =====
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=surplus-hub-uploads
AWS_S3_REGION=ap-northeast-2

# ===== Firebase Cloud Messaging (Optional) =====
# Only needed for raw FCM tokens. Expo clients need no server credentials:
# tokens starting with ExponentPushToken[ are routed to Expo's push service automatically.
# FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccountKey.json
# Optional — raises Expo's rate limits and required if you enable Expo push security.
# EXPO_ACCESS_TOKEN=

# ===== Upload =====
MAX_UPLOAD_SIZE_MB=10

# ===== AI Services =====
# AI Provider toggle: "default" (OpenAI+Gemini Dev) or "vertex" (Vertex AI)
AI_PROVIDER=default
# Google Gemini API Key (for image analysis, used when AI_PROVIDER=default)
# GOOGLE_AI_API_KEY=your-google-ai-api-key
# Google Cloud settings (used when AI_PROVIDER=vertex)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=asia-northeast3
# OpenAI API Key (for text generation, used when AI_PROVIDER=default)
# OPENAI_API_KEY=your-openai-api-key
# Embedding model (default: BAAI/bge-m3)
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # default, used when APP_ENV != local

# ===== Local LLM (APP_ENV=local only) =====
# When APP_ENV=local the API uses a local Ollama model for text generation and
# embeddings instead of OpenAI/Gemini. See dev/research/local-llm-setup-guide.md.
#   Prereq: `ollama serve`, `ollama pull gemma4:12b`, `ollama pull bge-m3`
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=gemma4:12b
# Reasoning models (gemma4/qwen3) must run with thinking OFF (kept false) — see guide pitfall #1.
LOCAL_LLM_THINK=false
LOCAL_LLM_TIMEOUT=300
# Local embedding model; its output dim MUST equal EMBEDDING_DIMENSION (bge-m3 = 1024).
LOCAL_EMBED_MODEL=bge-m3
LOCAL_API_KEY=ollama
